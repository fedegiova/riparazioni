# Copy to .env (local dev) or /etc/riparazioni/riparazioni.env (server).

# --- Flask -----------------------------------------------------------------
FLASK_APP=wsgi.py
# development | testing | production
FLASK_ENV=development
# 1 to enable debug mode with `flask run`
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production

# --- MSSQL database (pyodbc, ODBC Driver 18) --------------------------------
# mssql+pyodbc://USER:PASSWORD@HOST:1433/DB?driver=ODBC+Driver+18+for+SQL+Server
# URL-encode special characters in the password (% -> %25, ( -> %28, ...).
# TrustServerCertificate=yes is needed for the default self-signed server cert.
DATABASE_URL=mssql+pyodbc://sa:YourStrong%28Pass%29123@localhost:1433/riparazioni?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# --- Dev mode: local SQLite instead of MSSQL (FLASK_ENV=development only) ----
# Set to 1 to run the backend on local SQLite files: no MSSQL server or ODBC
# driver needed. Off by default; when on, DATABASE_URL is ignored.
# Testing and production environments always ignore these settings.
# DEV_MODE=0
# Full sqlite: URL for the primary database (owned tables).
# Default: <BASE_DIR>/var/dev.sqlite3
# DEV_DATABASE_URL=
# Full sqlite: URL for the external DATIDBSTORICO database.
# Default: sibling of the primary file with an _external suffix
# (var/dev_external.sqlite3).
# DEV_EXTERNAL_DATABASE_URL=
# Path to a custom seed SQL file for the external tables.
# Default: dev/seed_external.sql. After changing it, run
# `flask dev-init --reset` (DEV_MODE=1) to reseed.
# DEV_SEED_SQL=

# --- Writable runtime directories -------------------------------------------
# Defaults: <BASE_DIR>/var/uploads and <BASE_DIR>/var/log
# On the server set BASE_DIR=/opt/riparazioni and own the var/ tree with the
# service user (see README "Production deployment").
# BASE_DIR=/opt/riparazioni
# UPLOAD_DIR=
# LOG_DIR=

# --- Tests -------------------------------------------------------------------
# Default: in-memory SQLite (no MSSQL needed). Point it at a test DB if desired.
# TEST_DATABASE_URL=
