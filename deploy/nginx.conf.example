# /etc/nginx/sites-available/riparazioni
#
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/riparazioni
#   sudo ln -s ../sites-available/riparazioni /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Adjust server_name (and add TLS / certificate blocks) for your host.

upstream riparazioni_app {
    server 127.0.0.1:8000;
}

server {
    listen 80;
    listen [::]:80;
    server_name riparazioni.example.com;

    # Maximum upload size; raise as needed.
    client_max_body_size 50m;

    # Static files straight from the app package.
    location /static/ {
        alias /opt/riparazioni/app/static/;
        expires 7d;
    }

    location / {
        proxy_pass http://riparazioni_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
